{
  "name": "xsdsh-purge-next",
  "version": "1.0.1",
  "description": "dsh破甲 核心精简版（DSH NEXT / rc.4 专用；独立包名、模块 id、状态目录）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json",
    "./locator": "./tools/deepseek-harness-locator.mjs",
    "./reverse": "./lib/reverse/index.js",
    "./reverse/store": "./lib/reverse/store.js",
    "./reverse/ui": "./lib/reverse/ui.js",
    "./reverse/tools": "./lib/reverse/tools.js"
  },
  "bin": {
    "xsdsh-purge-next": "bin/Xsdsh-purge.js",
    "dsh-locate-harness": "tools/deepseek-harness-locator.mjs",
    "dsh-locate-harness-cmd": "tools/find-deepseek-harness.cmd"
  },
  "files": [
    "lib",
    "agents",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "src/ui",
    "tsconfig.json",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "tools",
    "!tools/probes"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:client:check": "node scripts/build-client.mjs --check",
    "typecheck": "tsc --project tsconfig.json",
    "test:ui-modules": "node --test test/ui-modules.test.mjs",
    "check:ui-boundaries": "node scripts/check-ui-boundaries.mjs",
    "lint:ui-hooks": "eslint src/ui --max-warnings=0 --no-inline-config",
    "gate": "node scripts/lint.mjs && npm run typecheck && npm run check:ui-boundaries && npm run lint:ui-hooks && node scripts/build-client.mjs --check && node scripts/check-host-matrix.mjs && node scripts/run-tests.mjs --mode=build",
    "gate:fast": "node scripts/lint.mjs && npm run typecheck && npm run check:ui-boundaries && npm run lint:ui-hooks && node scripts/build-client.mjs --check && node scripts/check-host-matrix.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:update": "node scripts/lint.mjs --update",
    "test": "node scripts/run-tests.mjs --mode=build",
    "test:build": "node scripts/run-tests.mjs --mode=build",
    "test:packaging": "node scripts/run-tests.mjs --mode=packaging",
    "test:look": "node test/look-layout.test.mjs && node --test test/titlebar-drag.test.mjs",
    "test:glass": "node test/glass-filter.test.mjs && node test/glass-adopt.test.mjs",
    "test:pet": "node test/cat.test.mjs && node test/pet.test.mjs && node test/pet-statemachine.test.mjs && node test/pet-visual.test.mjs && node test/pet-integration.test.mjs",
    "pet:frames": "python tools/make-pet-frames.py",
    "test:wallpaper": "node test/wallpaper.test.mjs",
    "test:wallpaper:pixel": "node test/wallpaper-pixel.test.mjs",
    "test:wallpaper:dom": "node test/wallpaper-dom.test.mjs",
    "test:wallpaper:local": "node test/wallpaper-local.test.mjs",
    "test:rename": "node test/rename-compat.test.mjs",
    "test:redteam-auth": "node test/redteam-auth.test.mjs",
    "test:settings": "node test/settings-render.test.mjs",
    "test:rewrite": "node --test test/rewrite-host.test.mjs test/rewrite-panel.test.mjs",
    "test:reverse": "node --test test/hide-console.test.mjs && node --test test/reverse-preset.test.mjs",
    "test:cheat": "node --test test/cheat-preset.test.mjs",
    "gen:cheat": "node scripts/gen-cheat-preset.mjs",
    "verify:install": "python tools/verify_install.py",
    "sync:install": "python tools/sync_install.py",
    "check:loop": "python tools/check_loop.py",
    "test:installer": "node --test test/install-src.test.mjs && node --test test/install-cmd.test.mjs",
    "test:presets": "node --test test/cheat-preset.test.mjs && node --test test/reverse-preset.test.mjs && node --test test/redteam-preset.test.mjs",
    "test:asar": "node --test test/asar-swap-restart.test.mjs",
    "test:prompts": "node --test test/preset-prompts.test.mjs",
    "test:quality": "node --test test/prompt-quality.test.mjs",
    "test:retry": "node --test test/refusal-retry.test.mjs",
    "test:shape": "node --test test/publish-shape.test.mjs"
  },
  "license": "MIT",
