        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/wodaimnd/xsdsh-purge-next/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/wodaimnd/xsdsh-purge-next/archive/refs/heads/main.zip",
      "git": "https://github.com/wodaimnd/xsdsh-purge-next.git"
